rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 16 &&
             data.level is int && data.level >= 1 && data.level <= 100 &&
             data.xp is int && data.xp >= 0 &&
             data.vipTier in ['NONE', 'VIP', 'SVIP'] &&
             data.discoverable is bool &&
             data.adultEligible is bool &&
             data.onlineVisible is bool &&
             data.onlineStatus in ['ONLINE', 'OFFLINE'] &&
             (!('avatarColorHex' in data) || (data.avatarColorHex is string && data.avatarColorHex.size() <= 16)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 40)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 30)) &&
             (!('profileFrame' in data) || (data.profileFrame is string && data.profileFrame.size() <= 32)) &&
             (!('nameColor' in data) || (data.nameColor is string && data.nameColor.size() <= 32)) &&
             (!('chatBubbleStyle' in data) || (data.chatBubbleStyle is string && data.chatBubbleStyle.size() <= 32)) &&
             (!('familyId' in data) || (data.familyId is string && data.familyId.size() <= 128)) &&
             (!('familyName' in data) || (data.familyName is string && data.familyName.size() <= 50)) &&
             (!('cpPartnerId' in data) || (data.cpPartnerId is string && data.cpPartnerId.size() <= 128)) &&
             (!('cpPartnerName' in data) || (data.cpPartnerName is string && data.cpPartnerName.size() <= 50)) &&
             (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0)) &&
             (!('friendsCount' in data) || (data.friendsCount is int && data.friendsCount >= 0)) &&
             (!('popularityScore' in data) || (data.popularityScore is int && data.popularityScore >= 0)) &&
             (!('giftsReceivedValue' in data) || (data.giftsReceivedValue is int && data.giftsReceivedValue >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserPrivate(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() <= 120 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 60 &&
             data.dobIso is string && data.dobIso.size() >= 8 && data.dobIso.size() <= 20 &&
             data.coinBalance is int && data.coinBalance >= 0 &&
             data.vipTier in ['NONE', 'VIP', 'SVIP'] &&
             data.hideOnline is bool &&
             data.hideLastSeen is bool &&
             data.allowFriendRequests is bool &&
             (!('vipExpiryMillis' in data) || data.vipExpiryMillis is int) &&
             (!('lastDailyClaimDay' in data) || (data.lastDailyClaimDay is string && data.lastDailyClaimDay.size() <= 20)) &&
             (!('lastDeviceLabel' in data) || (data.lastDeviceLabel is string && data.lastDeviceLabel.size() <= 80)) &&
             (!('blockedUids' in data) || (data.blockedUids is list && data.blockedUids.size() <= 50 && (data.blockedUids.size() == 0 || data.blockedUids[0] is string))) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWalletLedger(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.entryType is string && data.entryType.size() >= 2 && data.entryType.size() <= 32 &&
             data.amountCoins is int &&
             data.balanceAfter is int && data.balanceAfter >= 0 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 160 &&
             (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNotification(data) {
      return data.recipientId is string && isValidId(data.recipientId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 50 &&
             data.type is string && data.type.size() >= 2 && data.type.size() <= 32 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 200 &&
             data.read is bool &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidVoiceRoom(data) {
      return data.hostId is string && isValidId(data.hostId) &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 30 &&
             data.roomType in ['PUBLIC', 'PRIVATE', 'PASSWORD', 'FRIENDS', 'VIP'] &&
             data.language is string && data.language.size() >= 2 && data.language.size() <= 30 &&
             data.maxSeats is int && data.maxSeats >= 4 && data.maxSeats <= 12 &&
             data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 5000 &&
             data.status in ['LIVE', 'CLOSED'] &&
             data.publicListed is bool &&
             data.adultOnly is bool &&
             (!('passwordCode' in data) || (data.passwordCode is string && data.passwordCode.size() <= 32)) &&
             (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 240)) &&
             (!('themeKey' in data) || (data.themeKey is string && data.themeKey.size() <= 32)) &&
             (!('moderatorUids' in data) || (data.moderatorUids is list && data.moderatorUids.size() <= 10 && (data.moderatorUids.size() == 0 || data.moderatorUids[0] is string))) &&
             (!('seatUids' in data) || (data.seatUids is list && data.seatUids.size() <= 12 && (data.seatUids.size() == 0 || data.seatUids[0] is string))) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVoiceRoomSeat(data) {
      return data.roomId is string && isValidId(data.roomId) &&
             data.seatIndex is int && data.seatIndex >= 0 && data.seatIndex <= 11 &&
             data.occupantUid is string && data.occupantUid.size() <= 128 &&
             data.muted is bool &&
             data.locked is bool &&
             data.speaking is bool &&
             (!('occupantName' in data) || (data.occupantName is string && data.occupantName.size() <= 40)) &&
             (!('occupantAvatar' in data) || (data.occupantAvatar is string && data.occupantAvatar.size() <= 16)) &&
             (!('occupantVip' in data) || (data.occupantVip is string && data.occupantVip.size() <= 16)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRoomMessage(data) {
      return data.roomId is string && isValidId(data.roomId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
             data.messageType in ['TEXT', 'GIFT', 'SYSTEM'] &&
             (!('senderVip' in data) || (data.senderVip is string && data.senderVip.size() <= 16)) &&
             (!('senderChatBubble' in data) || (data.senderChatBubble is string && data.senderChatBubble.size() <= 32)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSpeakerRequest(data) {
      return data.roomId is string && isValidId(data.roomId) &&
             data.requesterId is string && isValidId(data.requesterId) &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 40 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             (!('requesterAvatar' in data) || (data.requesterAvatar is string && data.requesterAvatar.size() <= 16)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSocialRequest(data) {
      return data.fromUserId is string && isValidId(data.fromUserId) &&
             data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 40 &&
             data.toUserId is string && isValidId(data.toUserId) &&
             data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 40 &&
             data.fromUserId != data.toUserId &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.fromUserId in data.participantUids && data.toUserId in data.participantUids &&
             data.status in ['PENDING', 'ACCEPTED', 'REJECTED', 'CANCELLED', 'ENDED'] &&
             (!('fromAvatar' in data) || (data.fromAvatar is string && data.fromAvatar.size() <= 16)) &&
             (!('toAvatar' in data) || (data.toAvatar is string && data.toAvatar.size() <= 16)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFollow(data) {
      return data.followerId is string && isValidId(data.followerId) &&
             data.followingId is string && isValidId(data.followingId) &&
             data.followerId != data.followingId &&
             data.followingName is string && data.followingName.size() >= 1 && data.followingName.size() <= 40 &&
             (!('followingAvatar' in data) || (data.followingAvatar is string && data.followingAvatar.size() <= 16)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidConversation(data) {
      return data.memberUids is list && data.memberUids.size() >= 2 && data.memberUids.size() <= 50 &&
             data.memberUids[0] is string &&
             data.type in ['DIRECT', 'GROUP'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.adminUid is string && isValidId(data.adminUid) &&
             data.lastMessage is string && data.lastMessage.size() <= 200 &&
             (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 200)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDirectMessage(data) {
      return data.memberUids is list && data.memberUids.size() >= 2 && data.memberUids.size() <= 50 &&
             data.memberUids[0] is string &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.messageType in ['TEXT', 'STICKER', 'IMAGE', 'VOICE_NOTE'] &&
             data.deleted is bool &&
             (!('mediaUri' in data) || (data.mediaUri is string && data.mediaUri.size() <= 500)) &&
             (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 200)) &&
             (!('reaction' in data) || (data.reaction is string && data.reaction.size() <= 16)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidPrivateCall(data) {
      return data.callerId is string && isValidId(data.callerId) &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 40 &&
             data.calleeId is string && isValidId(data.calleeId) &&
             data.calleeName is string && data.calleeName.size() >= 1 && data.calleeName.size() <= 40 &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.callerId in data.participantUids && data.calleeId in data.participantUids &&
             data.status in ['RINGING', 'ACTIVE', 'ENDED', 'DECLINED', 'MISSED'] &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGiftTransaction(data) {
      return data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.recipientId is string && isValidId(data.recipientId) &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 40 &&
             data.giftId is string && data.giftId.size() >= 1 && data.giftId.size() <= 40 &&
             data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 40 &&
             data.giftEmoji is string && data.giftEmoji.size() >= 1 && data.giftEmoji.size() <= 16 &&
             data.coinCost is int && data.coinCost >= 1 && data.coinCost <= 1000000 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 2 &&
             data.senderId in data.participantUids && data.recipientId in data.participantUids &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFamily(data) {
      return data.ownerId is string && isValidId(data.ownerId) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 50 &&
             data.description is string && data.description.size() <= 240 &&
             data.emblemEmoji is string && data.emblemEmoji.size() >= 1 && data.emblemEmoji.size() <= 16 &&
             data.memberCount is int && data.memberCount >= 1 && data.memberCount <= 500 &&
             data.activityScore is int && data.activityScore >= 0 &&
             data.listed is bool &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 &&
             data.memberUids[0] is string &&
             (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 240)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFamilyMember(data) {
      return data.familyId is string && isValidId(data.familyId) &&
             data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.role in ['OWNER', 'CO_OWNER', 'ADMIN', 'MODERATOR', 'MEMBER'] &&
             data.status in ['PENDING', 'ACTIVE'] &&
             (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 16)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFamilyMessage(data) {
      return data.familyId is string && isValidId(data.familyId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidGameRecord(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.gameType is string && data.gameType.size() >= 2 && data.gameType.size() <= 32 &&
             data.periodId is string && data.periodId.size() >= 1 && data.periodId.size() <= 64 &&
             data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 64 &&
             data.stakeCoins is int && data.stakeCoins >= 0 && data.stakeCoins <= 100000 &&
             data.wonCoins is int && data.wonCoins >= 0 && data.wonCoins <= 1000000 &&
             data.outcome in ['WIN', 'LOSS', 'DRAW'] &&
             (!('detail' in data) || (data.detail is string && data.detail.size() <= 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return data.reporterId is string && isValidId(data.reporterId) &&
             data.targetId is string && isValidId(data.targetId) &&
             data.targetType in ['USER', 'ROOM', 'MESSAGE'] &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 60 &&
             data.status == 'SUBMITTED' &&
             (!('details' in data) || (data.details is string && data.details.size() <= 300)) &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    // 1. Public Profiles (No PII; discoverable list query enforced)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.discoverable == true;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'avatarEmoji', 'level', 'xp', 'vipTier', 'discoverable', 'adultEligible', 'onlineVisible', 'onlineStatus', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'displayName', 'avatarEmoji', 'avatarColorHex', 'bio',
                         'country', 'language', 'level', 'xp', 'vipTier', 'profileFrame',
                         'nameColor', 'chatBubbleStyle', 'familyId', 'familyName',
                         'cpPartnerId', 'cpPartnerName', 'followersCount', 'friendsCount',
                         'popularityScore', 'giftsReceivedValue', 'discoverable',
                         'onlineVisible', 'onlineStatus', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Private User Account, Wallet & Subcollections
    match /users_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'fullName', 'dobIso', 'coinBalance', 'vipTier', 'hideOnline', 'hideLastSeen', 'allowFriendRequests', 'createdAt', 'updatedAt']) &&
                       isValidUserPrivate(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserPrivate(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'coinBalance', 'vipTier', 'vipExpiryMillis',
                         'lastDailyClaimDay', 'blockedUids', 'hideOnline', 'hideLastSeen',
                         'allowFriendRequests', 'lastDeviceLabel', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /wallet_ledger/{entryId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(entryId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'entryType', 'amountCoins', 'balanceAfter', 'description', 'createdAt']) &&
                         isValidWalletLedger(incoming());
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(notifId) &&
                         incoming().recipientId == userId &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll(['recipientId', 'senderId', 'senderName', 'type', 'title', 'body', 'read', 'createdAt']) &&
                         isValidNotification(incoming());
        allow update: if isSignedIn() &&
                         isValidId(notifId) &&
                         request.auth.uid == userId &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().senderId == existing().senderId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNotification(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isSignedIn() && isValidId(notifId) && request.auth.uid == userId;
      }
    }

    // 3. Live Voice Chat Rooms & Subcollections
    match /voice_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.publicListed == true;
      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().keys().hasAll(['hostId', 'hostName', 'title', 'category', 'roomType', 'language', 'maxSeats', 'participantCount', 'status', 'publicListed', 'adultOnly', 'createdAt', 'updatedAt']) &&
                       isValidVoiceRoom(incoming());
      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       existing().status != 'CLOSED' &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidVoiceRoom(incoming()) &&
                       (
                         // Action 1: Host or Moderator updates room configuration or closes room
                         ((existing().hostId == request.auth.uid || ('moderatorUids' in existing() && request.auth.uid in existing().moderatorUids)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'roomType', 'passwordCode', 'announcement', 'themeKey', 'maxSeats', 'participantCount', 'status', 'publicListed', 'moderatorUids', 'seatUids', 'updatedAt'])) ||
                         // Action 2: Participant joins, leaves, or updates seat occupancy on live room
                         (existing().status == 'LIVE' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantCount', 'seatUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /seats/{seatId} {
        allow get: if isSignedIn() && isValidId(seatId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isSignedIn() &&
                         isValidId(seatId) &&
                         incoming().roomId == roomId &&
                         isValidVoiceRoomSeat(incoming()) &&
                         get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid;
        allow update: if isSignedIn() &&
                         isValidId(seatId) &&
                         incoming().roomId == existing().roomId &&
                         incoming().seatIndex == existing().seatIndex &&
                         isValidVoiceRoomSeat(incoming()) &&
                         (
                           // Host or moderator controls any seat
                           (get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid ||
                            ('moderatorUids' in get(/databases/$(database)/documents/voice_rooms/$(roomId)).data &&
                             request.auth.uid in get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.moderatorUids)) ||
                           // User takes an unlocked empty seat
                           (existing().locked == false && existing().occupantUid == '' && incoming().occupantUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['occupantUid', 'occupantName', 'occupantAvatar', 'occupantVip', 'muted', 'speaking', 'updatedAt'])) ||
                           // Seated user toggles own mic, speaking state, or steps down
                           (existing().occupantUid == request.auth.uid &&
                            (incoming().occupantUid == request.auth.uid || incoming().occupantUid == '') &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['occupantUid', 'occupantName', 'occupantAvatar', 'occupantVip', 'muted', 'speaking', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(seatId) &&
                         get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         isValidRoomMessage(incoming());
        allow update, delete: if false;
      }

      match /speaker_requests/{requesterId} {
        allow get: if isSignedIn() && isValidId(requesterId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isSignedIn() &&
                         isValidId(requesterId) &&
                         request.auth.uid == requesterId &&
                         incoming().roomId == roomId &&
                         incoming().requesterId == request.auth.uid &&
                         incoming().status == 'PENDING' &&
                         isValidSpeakerRequest(incoming());
        allow update: if isSignedIn() &&
                         isValidId(requesterId) &&
                         incoming().roomId == existing().roomId &&
                         incoming().requesterId == existing().requesterId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSpeakerRequest(incoming()) &&
                         (
                           (request.auth.uid == requesterId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                           (get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(requesterId) &&
                         (request.auth.uid == requesterId ||
                          get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.hostId == request.auth.uid);
      }
    }

    // 4. Friend Requests & CP Partner Requests
    match /friend_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().fromUserId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidSocialRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       existing().status in ['PENDING', 'ACCEPTED'] &&
                       incoming().fromUserId == existing().fromUserId &&
                       incoming().toUserId == existing().toUserId &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSocialRequest(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       (
                         (request.auth.uid == existing().toUserId && incoming().status in ['ACCEPTED', 'REJECTED', 'ENDED']) ||
                         (request.auth.uid == existing().fromUserId && incoming().status in ['CANCELLED', 'ENDED'])
                       );
      allow delete: if isSignedIn() && isValidId(requestId) && request.auth.uid in existing().participantUids;
    }

    match /cp_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().fromUserId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidSocialRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       existing().status in ['PENDING', 'ACCEPTED'] &&
                       incoming().fromUserId == existing().fromUserId &&
                       incoming().toUserId == existing().toUserId &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSocialRequest(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       (
                         (request.auth.uid == existing().toUserId && incoming().status in ['ACCEPTED', 'REJECTED', 'ENDED']) ||
                         (request.auth.uid == existing().fromUserId && incoming().status in ['CANCELLED', 'ENDED'])
                       );
      allow delete: if isSignedIn() && isValidId(requestId) && request.auth.uid in existing().participantUids;
    }

    // 5. Follows
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       incoming().followerId == request.auth.uid &&
                       isValidFollow(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
    }

    // 6. Direct & Group Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().adminUid == request.auth.uid &&
                       isValidConversation(incoming());
      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().type == existing().type &&
                       incoming().createdAt == existing().createdAt &&
                       isValidConversation(incoming()) &&
                       (
                         (existing().adminUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'announcement', 'memberUids', 'lastMessage', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(conversationId) && existing().adminUid == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && request.auth.uid in existing().memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         isValidDirectMessage(incoming());
        allow update: if isSignedIn() &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().memberUids &&
                         incoming().senderId == existing().senderId &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().createdAt == existing().createdAt &&
                         isValidDirectMessage(incoming()) &&
                         (
                           (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'deleted', 'reaction'])) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['reaction']))
                         );
        allow delete: if false;
      }
    }

    // 7. Private Voice Calls
    match /private_calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       incoming().callerId == request.auth.uid &&
                       incoming().status == 'RINGING' &&
                       isValidPrivateCall(incoming());
      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       request.auth.uid in existing().participantUids &&
                       existing().status in ['RINGING', 'ACTIVE'] &&
                       incoming().callerId == existing().callerId &&
                       incoming().calleeId == existing().calleeId &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPrivateCall(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'durationSeconds', 'updatedAt']);
      allow delete: if false;
    }

    // 8. Virtual Gift Transactions (Immutable)
    match /gift_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
                       isValidId(txId) &&
                       incoming().senderId == request.auth.uid &&
                       isValidGiftTransaction(incoming());
      allow update, delete: if false;
    }

    // 9. Families & Subcollections
    match /families/{familyId} {
      allow get: if isSignedIn() && isValidId(familyId);
      allow list: if isSignedIn() && resource.data.listed == true;
      allow create: if isSignedIn() &&
                       isValidId(familyId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       isValidFamily(incoming());
      allow update: if isSignedIn() &&
                       isValidId(familyId) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFamily(incoming()) &&
                       (
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'emblemEmoji', 'announcement', 'memberCount', 'activityScore', 'memberUids', 'listed', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'activityScore', 'memberUids', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(familyId) && existing().ownerId == request.auth.uid;

      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(memberId);
        allow list: if isSignedIn() && resource.data.familyId == familyId;
        allow create: if isSignedIn() &&
                         isValidId(memberId) &&
                         request.auth.uid == memberId &&
                         incoming().userId == request.auth.uid &&
                         incoming().familyId == familyId &&
                         isValidFamilyMember(incoming());
        allow update: if isSignedIn() &&
                         isValidId(memberId) &&
                         incoming().familyId == existing().familyId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidFamilyMember(incoming()) &&
                         get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(memberId) &&
                         (request.auth.uid == memberId ||
                          get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid);
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId);
        allow list: if isSignedIn() && resource.data.familyId == familyId;
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().familyId == familyId &&
                         incoming().senderId == request.auth.uid &&
                         isValidFamilyMessage(incoming());
        allow update, delete: if false;
      }
    }

    // 10. Mini-Game Records (Owner-scoped, immutable)
    match /game_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(recordId) &&
                       incoming().userId == request.auth.uid &&
                       isValidGameRecord(incoming());
      allow update, delete: if false;
    }

    // 11. Safety Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().reporterId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       isValidReport(incoming());
      allow update, delete: if false;
    }
  }
}
